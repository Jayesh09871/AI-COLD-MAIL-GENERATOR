# ==============================
# Core / Required
# ==============================
# NOTE: NODE_ENV defaults to "production" IN CODE if missing. Set to
# "development" explicitly when running locally to enable dev CORS for
# localhost:5173 and turn off production error masking.
NODE_ENV=development
PORT=5000
# FRONTEND_URL — comma-separated list allowed! Server tolerates:
#   • trailing slashes (added/removed automatically)
#   • www / non-www (both forms are auto-allowed)
#   • multiple origins (comma-separated, no spaces)
# Examples:
#   FRONTEND_URL=https://ai-cold-mail-generator.vercel.app
#   FRONTEND_URL=https://ai-cold-mail-generator.vercel.app,https://www.mycustomdomain.com
#   FRONTEND_URL=https://preview-abc.vercel.app,https://ai-cold-mail-generator.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/ai-cold-email
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai-cold-email
MONGO_URI=mongodb://127.0.0.1:27017/ai-cold-email

# JWT
JWT_SECRET=replace-with-a-long-random-string-use-openssl-rand
JWT_EXPIRES_IN=30d

# AI Provider (Groq)
GROQ_API_KEY=gsk_xxx_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# ================================================================
# EMAIL DELIVERY — Provider priority (HIGHEST → LOWEST)
#   1. RESEND API      (RECOMMENDED — HTTP, no SMTP, best deliverability)
#   2. GENERIC SMTP    (SendGrid / Mailgun / Brevo / AWS SES SMTP mode)
#   3. GMAIL SMTP      (LAST RESORT — Gmail blocks datacenter IPs!)
#
# NOTE: If NO provider is configured, signups still work — the OTP is
# printed to server logs (Render/Heroku Logs → search "Email dispatch"
# and look for the `otp:` field) so admins can manually verify.
# Set EMAIL_REQUIRE_DELIVERY=true ONLY if you want signup to fail when
# no email can be delivered (true production SaaS).
# ================================================================
EMAIL_REQUIRE_DELIVERY=false

# ----------------------------------------------------------------
# OPTION A — Resend API (RECOMMENDED, ~5 min setup)
#   1. Sign up at https://resend.com  → free tier = 100 emails/day
#   2. Copy API key from Settings → API Keys → Create API Key
#   3. (Optional for Inbox deliverability, not Spam folder)
#      In Resend → Domains → Add your domain → follow the DNS steps
#      to verify SPF+DKIM+DMARC. Until then Resend auto-sends from
#      "onboarding@resend.dev" which is fine for portfolio demos.
#   4. Paste below:
# ----------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=verify@yourdomain.com

# ----------------------------------------------------------------
# OPTION B — Generic SMTP (SendGrid / Mailgun / Brevo / AWS SES etc)
#   Configure ANY of these — they all provide standard SMTP creds.
#   Far more reliable than Gmail because their IPs are NOT flagged
#   as "datacenter spam" by Google/Microsoft spam filters.
#
#   SendGrid Example (30 days free trial, then 100/day free forever):
#     https://app.sendgrid.com/ → Settings → Sender Authentication
#     → Verify Single Sender → then Settings → API Keys → Create
#     → Mail Send permission → paste as SMTP_PASS below.
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_PORT=465
#     SMTP_SECURE=true
#     SMTP_USER=apikey
#     SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
#     SMTP_FROM=verified-sender@yourdomain.com
#
#   Mailgun Example:
#     SMTP_HOST=smtp.mailgun.org
#     SMTP_PORT=465
#     SMTP_USER=postmaster@sandboxXX.mailgun.org
#     SMTP_PASS=<your smtp password>
#     SMTP_FROM=SmartReach <verify@mg.yourdomain.com>
#
#   Brevo (formerly Sendinblue) — 300 emails/day free:
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_SECURE=false
#     SMTP_USER=xxxxxxxxxxxxxxxxxx
#     SMTP_PASS=xxxxxxxxxxxxxx
# ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----------------------------------------------------------------
# OPTION C — Gmail App Password (NOT RECOMMENDED FOR PRODUCTION)
#
#   Gmail aggressively blocks SMTP connections from Render/AWS/
#   Heroku/datacenter IP ranges with:
#     "534-5.7.9 Application-specific password required" OR
#     "530 5.7.1 Authentication required" → even with correct PW.
#
#   Works ONLY from your laptop's IP (local dev). For Render/live
#   deployments use RESEND or GENERIC SMTP above instead.
#
#   How to get (if you still want to try):
#     1. Gmail → Profile → Manage your Google Account → Security
#     2. Turn ON "2-Step Verification" (App Passwords require it)
#     3. Under 2-Step Verification → App passwords → Select app =
#        Other (Custom name) → generate 16-char app password
#     4. Paste the 16-char string as EMAIL_PASS (NOT your Gmail PW)
# ----------------------------------------------------------------
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# ==============================
# Security / Rate Limiting
# ==============================
MAX_BODY_SIZE=100kb

# Global API rate limit (requests/minute per IP)
GLOBAL_RATE_LIMIT_MAX=200

# Auth endpoints (15 minute windows)
STRICT_RATE_LIMIT_MAX=5   # register / verify-otp / resend-otp
AUTH_RATE_LIMIT_MAX=10    # login

# AI generation (1 minute windows)
GENERATE_RATE_LIMIT_MAX=20

# History reads (1 minute windows)
HISTORY_RATE_LIMIT_MAX=60

# ==============================
# Logging
# ==============================
LOG_LEVEL=debug

# ==============================
# POST-DEPLOY EMAIL DEBUG CHECKLIST
#   After adding the env vars on Render, run these in browser to
#   confirm email works WITHOUT doing a full signup flow:
#
#   1. GET   https://<your-backend>/health/email
#        → shows which providers the server has detected. If the one
#          you configured still shows `configured:false`, double-check
#          the exact spelling of the env var name in Render.
#   2. POST  https://<your-backend>/health/email/test?to=you@gmail.com
#        → sends a real test email. If it fails:
#          a) Read the "error" + "hint" fields in the response
#          b) Open Render → Logs → search "Email dispatch" for details
#          c) If Gmail: SMTP probably blocked your Render datacenter IP,
#             switch to Resend or Generic SMTP.
#
#   Step 1 + 2 together replace the old "have to run a full signup
#   and inspect Render logs" debug flow.
# ==============================
