# ==============================
# Core / Required
# ==============================
# NOTE: NODE_ENV defaults to "production" IN CODE if missing. Set to
# "development" explicitly when running locally to enable dev CORS for
# localhost:5173 and turn off production error masking.
NODE_ENV=development
PORT=5000
# FRONTEND_URL — comma-separated list allowed! Server tolerates:
#   • trailing slashes (added/removed automatically)
#   • www / non-www (both forms are auto-allowed)
#   • multiple origins (comma-separated, no spaces)
# Examples:
#   FRONTEND_URL=https://ai-cold-mail-generator.vercel.app
#   FRONTEND_URL=https://ai-cold-mail-generator.vercel.app,https://www.mycustomdomain.com
#   FRONTEND_URL=https://preview-abc.vercel.app,https://ai-cold-mail-generator.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/ai-cold-email
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai-cold-email
MONGODB_URI=mongodb://127.0.0.1:27017/ai-cold-email

# JWT
JWT_SECRET=replace-with-a-long-random-string-use-openssl-rand
JWT_EXPIRES_IN=30d

# AI Provider (Groq)
GROQ_API_KEY=gsk_xxx_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# ================================================================
# EMAIL DELIVERY — Brevo SMTP via Nodemailer (ONLY PROVIDER IN USE)
#
# NOTE: Gmail SMTP fallback is currently COMMENTED OUT in
#       emailService.js. Brevo is used EXCLUSIVELY for both localhost
#       AND production OTP delivery right now. To re-enable Gmail,
#       see the 3-step re-enable instructions inside emailService.js.
#
# Provider priority implemented by emailService.js (CURRENT):
#   1. BREVO SMTP   (ONLY — localhost + production, deliverable from any datacenter)
#
# Error-handling policy (strict, no false "OTP sent"):
#   • If BREVO vars are configured → emails MUST actually deliver.
#     If the provider fails, /api/auth/register and
#     /api/auth/resend-otp return HTTP 500 with message:
#     "Failed to send OTP email. Please retry in 30 seconds."
#     instead of falsely claiming the OTP was emailed.
#   • NO provider vars configured at all:
#        - NODE_ENV === 'development' → soft-fallthrough still works:
#          OTP is printed in a [DEV EMAIL] console banner so you can
#          test the full OTP flow locally without any SMTP account.
#        - NODE_ENV === 'production' → emailService returns
#          success=false and register errors out. No OTP is echoed
#          anywhere (no banner, no log, no pino otp: field).
# ================================================================

# ----------------------------------------------------------------
# BREVO SMTP — THE REQUIRED LIVE PROVIDER
#
#   Brevo (formerly Sendinblue) is a transactional email service with
#   a FREE TIER of 300 emails/day forever. That's plenty for a
#   portfolio project. Unlike Gmail SMTP, Brevo accepts connections
#   from Render/AWS/Heroku datacenter IPs.
#
#   Setup steps (~3 minutes):
#     1. Open https://www.brevo.com/  →  sign up free.
#     2. Top-right menu → SMTP & API → SMTP tab.
#     3. Copy the 4 values you see on that page:
#          • SMTP server      → SMTP_HOST
#          • Port: 587        → SMTP_PORT   (use STARTTLS, NOT SSL 465)
#          • Login            → SMTP_USER
#          • Master password  → SMTP_PASS   (click "Generate" if blank)
#     4. (Optional but recommended — lands in Gmail's Primary instead
#        of Spam folder):
#        Brevo → Settings → Sender domains → Add a domain → follow
#        the DNS SPF+DKIM+DMARC steps in your domain registrar.
#        Then set SMTP_FROM to an address at that domain, e.g.
#        "SmartReach AI <noreply@mail.yourportfolio.com>".
#     5. Paste the 5 vars below.
# ----------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartReach AI <onboarding@smartreach-ai.dev>
# SMTP_REPLY_TO — optional. Defaults to SMTP_FROM if blank.
# Point this at your real support/owner email so Gmail's "Not Spam" replies
# button replies go to you directly rather than the Brevo envelope.
SMTP_REPLY_TO=

# ----------------------------------------------------------------
# GMAIL SMTP — FALLBACK (CURRENTLY DISABLED / COMMENTED OUT IN CODE)
#
# NOTE: Gmail SMTP is currently COMMENTED OUT in emailService.js.
#       These EMAIL_USER / EMAIL_PASS vars will NOT be used until
#       you also uncomment the sendViaGmail function and re-add it
#       to the providers array inside emailService.js.
#
#       Brevo is used EXCLUSIVELY for both localhost AND production
#       OTP delivery right now.
#
# Gmail aggressively blocks SMTP from datacenter IPs (Render/Vercel
# AWS/etc). It will fail on live Render deployments even with a
# correct app password. Only use this for local laptop dev.
#
# EMAIL_USER = your Gmail address
# EMAIL_PASS = 16-char "App Password" (NOT your Gmail password!)
#   Gmail → Security → 2-Step Verification ON → App passwords →
#   Select app: Other (Custom name) → generate → paste here.
#
# TO RE-ENABLE Gmail fallback:
#   1. Uncomment the two lines below (EMAIL_USER / EMAIL_PASS)
#   2. In emailService.js: uncomment the sendViaGmail function block
#   3. In emailService.js sendEmail(): re-add { name: 'gmail-smtp',
#      fn: sendViaGmail } to the providers array
# ----------------------------------------------------------------
# EMAIL_USER=
# EMAIL_PASS=

# ==============================
# Security / Rate Limiting
# ==============================
MAX_BODY_SIZE=100kb

# Global API rate limit (requests/minute per IP)
GLOBAL_RATE_LIMIT_MAX=200

# Auth endpoints (15 minute windows)
STRICT_RATE_LIMIT_MAX=5   # register / verify-otp / resend-otp / forgot-password / reset-password
AUTH_RATE_LIMIT_MAX=10    # login

# AI generation (1 minute windows)
GENERATE_RATE_LIMIT_MAX=20

# History reads (1 minute windows)
HISTORY_RATE_LIMIT_MAX=60

# ==============================
# Logging
# ==============================
LOG_LEVEL=debug

# ==============================
# POST-DEPLOY EMAIL DEBUG CHECKLIST (Render LIVE)
#   After setting SMTP_* env vars in Render → Backend → Environment,
#   confirm Brevo works WITHOUT running a full signup flow:
#
#   1. GET   https://<your-backend>/health/email
#        → providers.brevoSmtp.configured should show TRUE. If it's
#          still false, double-check the EXACT spelling of the 5
#          SMTP_* variable names in Render (SMTP_HOST, SMTP_PORT,
#          SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM).
#   2. POST  https://<your-backend>/health/email/test?to=you@gmail.com
#        → Sends a real test email. Response result.deliveredBy
#          should equal "brevo-smtp:smtp-relay.brevo.com".
#
#   If both work → OTP emails will arrive on Register, Resend OTP,
#   and Forgot Password for all users. If #2 fails:
#     • Read the "error" + "hint" fields in the JSON response
#     • Open Render → Logs → search "Email dispatch" for full
#       provider error context.
#     • If you see "Invalid login or password": re-copy SMTP_USER
#       + SMTP_PASS from Brevo → SMTP & API page exactly.
# ==============================
